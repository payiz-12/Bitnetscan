{
  "name": "BitnetScan · Bitnet (BTN) Explorer",
  "short_name": "BitnetScan",
  "description": "Block explorer for Bitnet (BTN): blocks, transactions, addresses, mining, supply and network charts.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#F8F7F4",
  "theme_color": "#0f172a",
  "categories": ["finance", "utilities"],
  "icons": [
    { "src": "/pwa-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/pwa-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/pwa-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Mining", "url": "/#/mining", "icons": [{ "src": "/pwa-192.png", "sizes": "192x192" }] },
    { "name": "Charts", "url": "/#/charts", "icons": [{ "src": "/pwa-192.png", "sizes": "192x192" }] },
    { "name": "Supply", "url": "/#/supply", "icons": [{ "src": "/pwa-192.png", "sizes": "192x192" }] }
  ]
}
