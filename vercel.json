{
  "git": {
    "deploymentEnabled": {
      "data": false,
      "chain-data": false
    }
  },
  "functions": {
    "api/reorgs.js": { "maxDuration": 60 },
    "api/miners.js": { "maxDuration": 30 },
    "api/chain-daily.js": { "maxDuration": 30 },
    "api/rpc.js": { "maxDuration": 30 },
    "api/rpc2.js": { "maxDuration": 30 },
    "api/og.js": {
      "maxDuration": 30,
      "includeFiles": "{api/_fonts/**,api/_assets/**,node_modules/@resvg/resvg-wasm/index_bg.wasm}"
    }
  },
  "rewrites": [
    { "source": "/tx/:id", "destination": "/api/share?type=tx&id=:id", "has": [{ "type": "header", "key": "user-agent", "value": ".*(TelegramBot|Twitterbot|Discordbot|WhatsApp|facebookexternalhit|Facebot|Slackbot|LinkedInBot|SkypeUriPreview|Mastodon|Cardyb|redditbot|Iframely|Embedly).*" }] },
    { "source": "/block/:id", "destination": "/api/share?type=block&id=:id", "has": [{ "type": "header", "key": "user-agent", "value": ".*(TelegramBot|Twitterbot|Discordbot|WhatsApp|facebookexternalhit|Facebot|Slackbot|LinkedInBot|SkypeUriPreview|Mastodon|Cardyb|redditbot|Iframely|Embedly).*" }] },
    { "source": "/address/:id", "destination": "/api/share?type=address&id=:id", "has": [{ "type": "header", "key": "user-agent", "value": ".*(TelegramBot|Twitterbot|Discordbot|WhatsApp|facebookexternalhit|Facebot|Slackbot|LinkedInBot|SkypeUriPreview|Mastodon|Cardyb|redditbot|Iframely|Embedly).*" }] },
    { "source": "/token/:id", "destination": "/api/share?type=address&id=:id", "has": [{ "type": "header", "key": "user-agent", "value": ".*(TelegramBot|Twitterbot|Discordbot|WhatsApp|facebookexternalhit|Facebot|Slackbot|LinkedInBot|SkypeUriPreview|Mastodon|Cardyb|redditbot|Iframely|Embedly).*" }] },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/api/chain-history", "destination": "/api/chain-daily?view=history" },
    { "source": "/api/holding", "destination": "/api/chain-daily?view=holding" },
    { "source": "/api/transfers", "destination": "/api/chain-daily?view=transfers" },
    { "source": "/api/network-status", "destination": "/api/chain-daily?view=status" },
    { "source": "/api/miner", "destination": "/api/chain-daily?view=miner" },
    { "source": "/api/coolpool/:path*", "destination": "https://coolpool.top/:path*" },
    {
      "source": "/api/nestex/:path*",
      "destination": "https://api.nestex.one/:path*"
    },
    {
      "source": "/api/explorer/:path*",
      "destination": "https://explorer.bitnetmoney.org/:path*"
    },
    {
      "source": "/api/stats/:path*",
      "destination": "https://stats.explorer.bitnetmoney.com/:path*"
    },
    {
      "source": "/api/bitnet-explorer/:path*",
      "destination": "https://explorer.bitnetmoney.org/:path*"
    },
    {
      "source": "/api/gtpool/:path*",
      "destination": "https://gtpool.io/:path*"
    },
    {
      "source": "/api/gtpool",
      "destination": "https://gtpool.io/"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, Accept" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
    }
  ]
}
